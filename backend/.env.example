# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=agronex
POSTGRES_PASSWORD=agronex_dev
POSTGRES_DB=agronex
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agronex:agronex_dev@localhost:5432/agronex?schema=public

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Rate Limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Swagger ─────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
